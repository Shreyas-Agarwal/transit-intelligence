{
  "name": "transit-intelligence",
  "version": "1.0.0",
  "private": true,
  "description": "Transit Intelligence Platform Monorepo",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.1.3"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2",
    "turbo": "^2.0.4",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
