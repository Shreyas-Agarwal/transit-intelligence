# =============================================================================
# Transit Intelligence — Environment Variables
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be committed.
# =============================================================================

# -----------------------------------------------------------------------------
# GTFS-RT Feed — Open Data Swiss
# https://opentransportdata.swiss
# -----------------------------------------------------------------------------

# Unified GTFS-RT feed endpoint (combined vehicle positions, trip updates, alerts)
GTFS_RT_FEED_URL=https://api.opentransportdata.swiss/la/gtfs-rt

# Bearer token from the Open Data Swiss API Manager
# Obtain from: https://opentransportdata.swiss/en/dev-api/
GTFS_RT_API_TOKEN=your-api-token-here

# Poll interval in milliseconds (default: 30000 = 30 seconds)
# Per ADR 0007: feed updates every 20–30 seconds
GTFS_RT_POLL_INTERVAL_MS=30000

# Connect/request timeout for the feed HTTP client, in seconds (defaults shown)
# GTFS_RT_CONNECT_TIMEOUT_SECS=10
# GTFS_RT_REQUEST_TIMEOUT_SECS=15

# -----------------------------------------------------------------------------
# GTFS Static (GTFS-S) Timetable — CKAN API, Open Data Swiss
# https://data.opentransportdata.swiss/dataset/timetable-2026-gtfs2020
# Used by the GTFS-S auto-downloader (see docs/design/gtfs-static-auto-downloader.md)
# -----------------------------------------------------------------------------

# CKAN Action API base URL for the opentransportdata.swiss catalog
GTFS_S_CKAN_API_URL=https://api.opentransportdata.swiss/ckan-api

# CKAN dataset identifier for the current Fahrplan year
GTFS_S_CKAN_DATASET_ID=timetable-2026-gtfs2020

# API token + token hash issued under the same opentransportdata.swiss application as
# GTFS_RT_API_TOKEN above, but a distinct credential pair scoped to the CKAN API.
# Obtain from: https://opentransportdata.swiss/en/dev-api/
# Confirmed: the CKAN API accepts the token alone as a bearer token
# (Authorization: Bearer <token>). The token hash is not required by this API but
# is still provisioned here as part of the issued credential pair.
GTFS_S_CKAN_API_TOKEN=your-ckan-api-token-here
GTFS_S_CKAN_API_TOKEN_HASH=your-ckan-api-token-hash-here

# Where downloaded/extracted GTFS-S snapshots are stored. Defaults to
# <repo_root>/data/bronze/static if unset — only set this to override that.
# GTFS_S_RAW_DIR=/absolute/or/relative/path

# Ignore upstream versions older than this date (YYYYMMDD) during discovery, as
# if they were never published — avoids backfilling the CKAN catalog's full
# history on first run. Set to an empty string to disable and consider every
# version upstream still lists.
GTFS_S_CUTOFF_VERSION=20260101

# -----------------------------------------------------------------------------
# Redpanda (Kafka-compatible broker)
# Sprint 02: Redpanda runs in WSL2, accessible from Windows at localhost:9092
# -----------------------------------------------------------------------------

# Comma-separated list of broker addresses
REDPANDA_BROKERS=localhost:9092

# Client identifier reported to Redpanda by the realtime ingestion worker
KAFKA_CLIENT_ID=transit-ingestion-worker

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Sprint 01 baseline, not used by ingestion worker)
# -----------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transit_intelligence
